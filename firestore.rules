rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles & private data: persistent storage
    match /users/{userId} {
      allow read, write: if true;
      
      match /private_data/{docId} {
        allow read, write: if true;
      }
    }

    // Community posts: public read and persistent write
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Communities: public read, updates allowed
    match /communities/{communityId} {
      allow read, write: if true;
    }

    // Chat messages
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Events and collaborative sessions (with file uploads)
    match /events/{eventId} {
      allow read, write: if true;

      match /files/{fileId} {
        allow read, write: if true;
      }

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }
  }
}
